# Скопируйте в .env и заполните. Ключ не попадает в git (.env в .gitignore).

# Провайдер (OpenAI-совместимый endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Опционально
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# false - если модель не поддерживает structured output
LLM_JSON_MODE=true

# Лимит запросов в минуту (0 - без ограничения)
LLM_RPM=200
